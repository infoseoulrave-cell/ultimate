# Ultimate agent — copy to .env or set in shell
# Or put in ~/.ultimate/config.json as { "apiKey": "...", "model": "..." }
# 궁극 목표: 수익화. 돈이 될 소스·스스로 돈을 버는 시스템 아이디어는 언제든 사용자에게 물어봐도 됨.

OPENAI_API_KEY=sk-...
# ULTIMATE_API_KEY=sk-...   # alternative
# ULTIMATE_MODEL=gpt-4o-mini
# ULTIMATE_HOME=~/.ultimate
# OPENCLAW_PATH=openclaw
